"""Typed Python boundary for the optional Rust parameter storage backend."""

from collections.abc import Callable, Iterable
from typing import Any

BACKEND: str

type Endpoint = tuple[str, float]
type Bounds = tuple[Endpoint, Endpoint]

class BoundBatch:
    """Opaque immutable native endpoints, shared only during owner ingestion."""

def prepare_bounds(
    values: Iterable[Any],
    fallback: Callable[[Any], Bounds | None],
) -> BoundBatch:
    """Convert validated intervals directly into native storage before mutation."""
    ...

def validate_bounds(
    values: Iterable[Any],
    fallback: Callable[[Any], tuple[float, float]],
) -> list[tuple[float, float]]:
    """Validate built-in pairs in bulk, preserving Python fallback behavior."""
    ...

def encode_bounds(
    values: Iterable[Any],
    fallback: Callable[[Any], Bounds | None],
) -> list[Bounds | None]:
    """Encode validated endpoints in bulk before constructing native records."""
    ...

type AffineRecord = tuple[
    list[tuple[int, int, int]],
    list[int | float],
    int | float,
]

class NativeSelector:
    """Opaque validated local membership, produced by coordinate selection."""
    def at(self, position: int) -> int: ...
    def last(self, member: int) -> int | None: ...

class AffineRows:
    """Immutable affine batches with exact integer and native real arithmetic."""
    def __init__(self, rows: list[AffineRecord]) -> None: ...
    @staticmethod
    def numeric(handle: NumericPayload | NumericSnapshot) -> AffineRows: ...
    @staticmethod
    def constants(values: list[int | float]) -> AffineRows: ...
    @staticmethod
    def variables(table: MemberTable) -> AffineRows: ...
    def combine(
        self,
        other: AffineRows,
        left: list[int],
        right: list[int],
        operation: str,
    ) -> AffineRows: ...
    def take(self, positions: list[int]) -> AffineRows: ...
    def select(self, positions: NativeSelector) -> AffineRows: ...
    def sum_all(self) -> AffineRows: ...
    def sum_groups(self, groups: list[list[int]]) -> AffineRows: ...
    def sum_terms(self, groups: list[list[int]] | None) -> AffineRows: ...
    def sum_python(self, groups: list[list[int]] | None) -> AffineRows: ...
    def offsets(self) -> list[int | float]: ...
    def with_offsets(self, values: list[int | float]) -> AffineRows: ...
    def __len__(self) -> int: ...
    def coefficients(self, position: int) -> list[int | float]: ...
    def columns(self, position: int) -> list[int]: ...
    def offset(self, position: int) -> int | float: ...
    def matrix(self, position: int) -> list[tuple[int, int | float]]: ...
    def contains(self, owner: int, member: int) -> bool: ...
    def membership(self) -> RowMembership: ...
    def export(self) -> list[AffineRecord]: ...

class RowMembership:
    """Optional ordered row positions for native constraint membership."""
    def rows(self, owner: int, member: int) -> list[int]: ...
    def buffer_bytes(self) -> int: ...

class MemberTable:
    """Shared native coordinates, global column IDs and optional exact intervals."""
    def __init__(
        self,
        keys: list[list[int]],
        numbers: list[int],
        bounds: list[Bounds | None] | BoundBatch,
    ) -> None: ...
    @staticmethod
    def cartesian(
        axes: list[list[int]],
        numbers: list[int],
        bounds: list[Bounds | None] | BoundBatch,
    ) -> MemberTable:
        """Own unique ordered axes without expanded coordinate rows."""
        ...
    def append(
        self,
        keys: list[list[int]],
        numbers: list[int],
        bounds: list[Bounds | None] | BoundBatch,
    ) -> None: ...
    def __len__(self) -> int: ...
    def id(self, position: int) -> int: ...
    def key(self, position: int) -> list[int]: ...
    def lookup(self, key: list[int]) -> int: ...
    def lookup_many(self, keys: list[list[int]]) -> list[int]: ...
    def take(self, positions: list[int]) -> MemberTable: ...
    def product(
        self,
        axes: list[list[int]],
        *,
        last: bool = False,
    ) -> tuple[MemberTable, NativeSelector]: ...
    def freeze(self) -> MemberTable: ...
    def number(self, position: int) -> int: ...
    def bounds(self, position: int) -> Bounds | None: ...
    def set_bounds(self, position: int, bounds: Bounds) -> None: ...
    def all_bounds(self) -> list[Bounds | None]: ...
    def export(self) -> list[tuple[list[int], int, Bounds | None]]: ...

class NumericOwner:
    """Stable root retaining the current detachable numeric payload."""
    def __init__(self, values: list[float]) -> None: ...
    def payload(self) -> NumericPayload: ...
    def replace(self, values: list[float]) -> None: ...

class NumericPayload:
    """Mutable, versioned native numbers with atomic batch writes."""
    def __init__(self, values: list[float]) -> None: ...
    def values(self) -> list[float]: ...
    def __len__(self) -> int: ...
    def get(self, position: int) -> float: ...
    def set_many(self, positions: list[int], values: list[float]) -> None: ...
    def append(self, values: list[float]) -> None: ...
    def span(self, start: int, step: int, length: int) -> NumericSnapshot: ...
    def take(self, positions: list[int]) -> NumericSnapshot: ...
    def select(self, selector: NativeSelector) -> NumericSnapshot: ...
    @property
    def version(self) -> int: ...
    @property
    def reserved_bytes(self) -> int: ...

class NumericSnapshot:
    """Immutable values and fixed membership sharing a retained data version."""
    def values(self) -> list[float]: ...
    def __len__(self) -> int: ...
    def get(self, position: int) -> float: ...
    def take(self, positions: list[int]) -> NumericSnapshot: ...
    def select(self, selector: NativeSelector) -> NumericSnapshot: ...
    @property
    def version(self) -> int: ...
    @property
    def reserved_bytes(self) -> int: ...

class SparseRows:
    """Detached exact CSR compilation with checked global column IDs."""

    def __init__(
        self,
        batches: list[AffineRows],
        columns: int,
        *,
        owners: list[list[bool]] | None = None,
        negate: bool = False,
        column_tables: list[list[MemberTable | None]] | None = None,
    ) -> None: ...
    def parts(self) -> tuple[list[int | float], list[int], list[int]]: ...
    def dense(self) -> list[list[int | float]]: ...
    def rhs(self) -> list[int | float]: ...
    @property
    def shape(self) -> tuple[int, int]: ...
    @property
    def reserved_bytes(self) -> int: ...
